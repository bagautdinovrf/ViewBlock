{
  "manifest_version": 3,
  "name": "ViewBlock",
  "version": "1.5.0",
  "minimum_chrome_version": "114",
  "description": "Оставляйте или скрывайте выбранные блоки страницы. Правила и видимость помощника сохраняются для каждого сайта.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ViewBlock — только нужное",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none';" }
}

